+    device half*        out      [[buffer(4)]],
+    constant uint& M             [[buffer(5)]],
+    constant uint& N             [[buffer(6)]],
+    constant uint& K             [[buffer(7)]],
+    constant uint& group_size    [[buffer(8)]],
+    constant uint& bits          [[buffer(9)]],
